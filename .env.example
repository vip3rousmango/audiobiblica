# Copy to .env and adjust. Every variable is optional.
#
# Only the Docker bundle reads this file (docker compose). For a source install,
# export the same variables in your shell instead.

# Where Ollama runs. The default reaches an Ollama installed on your Mac.
# If you start the optional Ollama container instead
# (`docker compose --profile ollama up -d`), set this to the container:
# OLLAMA_BASE_URL=http://ollama:11434

# A Nanobot gateway, if you run one.
# NANOBOT_BASE_URL=http://host.docker.internal:8900

# Optional. Web search uses your own Firecrawl key; everything else works without it.
# You can also save the key in Settings, which is easier.
# FIRECRAWL_API_KEY=
