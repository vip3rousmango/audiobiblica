# Copy to .env and adjust. Every variable is optional.

# Where the UI is served from. Empty means "same origin as the page", which is what the
# packaged bundle uses. Set it only if you serve the built UI from somewhere else.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend (runtime, read by the server process -- not by the Vite build)
# AUDIOBIBLICA_DATA_DIR=~/.audiobiblica
# AUDIOBIBLICA_DB_PATH=~/.vip3rousmango/audiobiblica.db
# AUDIOBIBLICA_CONFIG_PATH=~/.audiobiblica/config.json
# AUDIOBIBLICA_MANUAL_DIR=~/.audiobiblica/manuals
# AUDIOBIBLICA_UI_DIR=/app/ui
# AUDIOBIBLICA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,host.docker.internal:*
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# NANOBOT_BASE_URL=http://127.0.0.1:8900
# ASSISTANT_MODEL=llama3.2:3b
# ASSISTANT_TIMEOUT=180
# FIRECRAWL_API_KEY=
