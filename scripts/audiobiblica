#!/usr/bin/env bash
# Start AudioBiblica, or update it, and open it in the browser.
#
# One command for everything the user does: the first run installs the app, and
# every run after that is also how it updates. It keeps its own copy of the two
# files it needs in ~/.audiobiblica/app, refreshes them when it can, pulls the
# published image, and starts both containers. Nothing here needs git, and nothing
# builds on the machine that runs it.
set -euo pipefail

STATE="${AUDIOBIBLICA_HOME:-$HOME/.audiobiblica}/app"
SOURCE="${AUDIOBIBLICA_SOURCE:-https://raw.githubusercontent.com/vip3rousmango/audiobiblica/main}"
COMPOSE_FILE="${STATE}/docker-compose.yml"

DOCKER_HELP="AudioBiblica needs Docker Desktop once. Download it at https://www.docker.com/products/docker-desktop/ and run this command again."

if ! command -v docker >/dev/null 2>&1; then
  echo "$DOCKER_HELP"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is installed but not running. Open Docker Desktop, wait until it says it is running, then run this command again."
  exit 1
fi

mkdir -p "$STATE"

# A checkout beside this script is the fallback when there is no network.
CHECKOUT="$(cd "$(dirname "$0")/.." && pwd)"
fetch() {
  name="$1"
  if curl -fsSL --max-time 20 "${SOURCE}/${name}" -o "${STATE}/${name}.new" 2>/dev/null; then
    mv "${STATE}/${name}.new" "${STATE}/${name}"
    return 0
  fi
  rm -f "${STATE}/${name}.new"
  return 1
}

echo "Checking for the newest version of the app files..."
if ! fetch docker-compose.yml || ! fetch updater.sh; then
  if [ -f "${CHECKOUT}/docker-compose.yml" ] && [ -f "${CHECKOUT}/scripts/updater.sh" ]; then
    echo "Could not reach the internet, so using the copy in ${CHECKOUT}."
    cp "${CHECKOUT}/docker-compose.yml" "$COMPOSE_FILE"
    cp "${CHECKOUT}/scripts/updater.sh" "${STATE}/updater.sh"
  elif [ -f "$COMPOSE_FILE" ]; then
    echo "Could not reach the internet, so using the copy already in ${STATE}. Updating needs a connection."
  else
    echo "Could not reach the internet and there is no local copy to start from."
    exit 1
  fi
fi

compose() {
  docker compose -f "$COMPOSE_FILE" --project-directory "$STATE" "$@"
}

# The address a phone should use to reach this app. A container cannot work this
# out — inside Docker it only sees its own address — so it is filled in here,
# from the machine, and refreshed on every run: a laptop that moves between
# networks gets a new address, and a pairing link pointing at the old one would
# fail silently.
detect_lan_address() {
  if command -v ipconfig >/dev/null 2>&1; then
    iface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')"
    [ -n "${iface:-}" ] && ipconfig getifaddr "$iface" 2>/dev/null && return 0
  fi
  if command -v ip >/dev/null 2>&1; then
    ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}' && return 0
  fi
  hostname -I 2>/dev/null | awk '{print $1}'
}

refresh_lan_address() {
  [ -n "${AUDIOBIBLICA_LAN_ADDRESS:-}" ] && return 0   # an explicit choice wins
  address="$(detect_lan_address || true)"
  [ -z "${address:-}" ] && return 0
  env_file="${STATE}/.env"
  touch "$env_file"
  grep -v '^AUDIOBIBLICA_LAN_ADDRESS=' "$env_file" >"${env_file}.tmp" 2>/dev/null || true
  printf 'AUDIOBIBLICA_LAN_ADDRESS=%s\n' "$address" >>"${env_file}.tmp"
  mv "${env_file}.tmp" "$env_file"
  echo "Phones on this network reach the app at http://${address}:8000 (Settings → Mobile capture)."
}

refresh_lan_address

if [ "${AUDIOBIBLICA_VERSION:-latest}" = "latest" ]; then
  echo "Downloading the newest AudioBiblica..."
  compose pull -q audiobiblica 2>/dev/null || echo "Could not download a new version; starting what is already installed."
fi

echo "Starting AudioBiblica. The first run takes a few minutes."
compose up -d

echo "Waiting for AudioBiblica to be ready..."
for _ in $(seq 1 90); do
  if health="$(curl -fsS http://localhost:8000/health 2>/dev/null)"; then
    version="$(printf '%s' "$health" | sed -n 's/.*"version"[: ]*"\([^"]*\)".*/\1/p')"
    if [ -n "$version" ]; then
      echo "AudioBiblica $version is running. Opening http://localhost:8000"
    else
      echo "AudioBiblica is running. Opening http://localhost:8000"
    fi
    if command -v open >/dev/null 2>&1; then
      open http://localhost:8000
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open http://localhost:8000
    fi
    echo "It can also update itself from inside the app: Settings → Check my setup, or the notice on the Overview."
    exit 0
  fi
  sleep 2
done

echo "AudioBiblica did not start within three minutes. The last log lines were:"
compose logs --tail 40 audiobiblica
exit 1
